<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Astropiano libraries are not yet on a feed; sibling-repo package output.
         Layout per axn-dev setup: dev/libraries/<repo> checked out side by side. -->
