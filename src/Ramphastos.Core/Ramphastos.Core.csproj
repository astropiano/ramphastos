<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Server-authoritative object-graph sync engine: replicated models, session actors, commands, roles, and streams.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- TestSdk mirrors internals (member model, serializer) for assertions. -->
    <InternalsVisibleTo Include="Ramphastos.TestSdk" />
    <InternalsVisibleTo Include="Ramphastos.Core.Facts" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Condition="'$(RamphastosLocalDeps)' != 'true'" Include="TotalSerializer.ReflectionTools" />
    <PackageReference Condition="'$(RamphastosLocalDeps)' != 'true'" Include="TotalSerializer" />
    <ProjectReference Condition="'$(RamphastosLocalDeps)' == 'true'" Include="$(RamphastosLocalDepsRoot)totalserializer\src\TotalSerializer.ReflectionTools\TotalSerializer.ReflectionTools.csproj" />
    <ProjectReference Condition="'$(RamphastosLocalDeps)' == 'true'" Include="$(RamphastosLocalDepsRoot)totalserializer\src\TotalSerializer\TotalSerializer.csproj" />
    <PackageReference Include="DiffMatchPatch" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="StackExchange.Redis" />
    <ProjectReference Include="..\Ramphastos.Protocol\Ramphastos.Protocol.csproj" />
  </ItemGroup>

</Project>
