<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>View-model graph, notification engine, and session actor for Ramphastos server-side MVVM applications.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- TestSdk mirrors internals (member model, serializer) for assertions. -->
    <InternalsVisibleTo Include="Ramphastos.TestSdk" />
    <InternalsVisibleTo Include="Ramphastos.Core.Facts" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TotalSerializer.ReflectionTools" />
    <PackageReference Include="TotalSerializer" />
    <PackageReference Include="DiffMatchPatch" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="StackExchange.Redis" />
    <ProjectReference Include="..\Ramphastos.Protocol\Ramphastos.Protocol.csproj" />
  </ItemGroup>

</Project>
