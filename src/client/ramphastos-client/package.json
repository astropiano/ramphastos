{
  "name": "ramphastos-client",
  "version": "0.2.0",
  "description": "Framework-agnostic client for the Ramphastos sync protocol — replicated object graphs, commands, and binary streams",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/astropiano/ramphastos.git",
    "directory": "src/client/ramphastos-client"
  },
  "license": "MIT",
  "keywords": ["sync", "replication", "object-graph", "state-sync", "realtime", "mvvm", "signalr", "websocket", "ramphastos"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@microsoft/signalr": "^9.0.6"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
