{
  "name": "ramphastos-react",
  "version": "0.2.0",
  "description": "React bindings for Ramphastos sync sessions — useViewModel over the replicated object graph",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/astropiano/ramphastos.git",
    "directory": "src/client/ramphastos-react"
  },
  "license": "MIT",
  "keywords": ["sync", "replication", "object-graph", "state-sync", "realtime", "mvvm", "signalr", "websocket", "ramphastos"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "ramphastos-client": "^0.2.0"
  },
  "devDependencies": {
    "react": "^19.1.0",
    "@types/react": "^19.1.0",
    "typescript": "^5.8.0"
  }
}
