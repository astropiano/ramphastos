# hello-world web — build workspace + vite, serve static via nginx
FROM node:22 AS build
WORKDIR /repo

COPY package.json package-lock.json ./
COPY src/client/ramphastos-client src/client/ramphastos-client
COPY src/client/ramphastos-react src/client/ramphastos-react
COPY examples/hello-world/web examples/hello-world/web

RUN npm ci
RUN npm run build -w @astropiano/ramphastos-client \
 && npm run build -w @astropiano/ramphastos-react \
 && npm run build -w hello-world-web

FROM nginx:alpine
COPY --from=build /repo/examples/hello-world/web/dist /usr/share/nginx/html
EXPOSE 80
