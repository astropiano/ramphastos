# HelloWorld.Server — build + run the Ramphastos host
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /repo

COPY Directory.Packages.props .
COPY src/Ramphastos.Protocol src/Ramphastos.Protocol
COPY src/Ramphastos.Core src/Ramphastos.Core
COPY src/Ramphastos.Server src/Ramphastos.Server
COPY examples/hello-world/HelloWorld.Server examples/hello-world/HelloWorld.Server

RUN dotnet publish examples/hello-world/HelloWorld.Server/HelloWorld.Server.csproj \
    -c Release -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app .

ENV ASPNETCORE_URLS=http://+:5000
EXPOSE 5000
ENTRYPOINT ["dotnet", "HelloWorld.Server.dll"]
